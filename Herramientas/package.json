{
  "name": "laqp-website",
  "version": "1.0.0",
  "private": true,
  "description": "Build estatico para LAqP.website en GitHub Pages.",
  "scripts": {
    "build": "node Mantenimiento/build-site.js",
    "normalize:ads": "node Mantenimiento/normalize-ad-markup.js",
    "build:builder-index": "python Generadores/generar_web.py --cli --builder-index-only",
    "test": "python -m unittest discover -s Pruebas -v && node --test Pruebas/*.test.js",
    "test:builder": "node --test Pruebas/squad-builder.test.js",
    "test:scouting": "node Pruebas/scouting-realism.test.js",
    "validate-site": "node Mantenimiento/validate-site.js"
  }
}
